# Assets generated by the setup window beside the package root
/Generated/
/Generated.meta

# Exported unitypackages. The trailing ~ keeps Unity from importing them.
/dist~/

# IDE
*.user
.vs/
.idea/
.vscode/

# Unity-side artifacts that must never be committed from a consuming project
Library/
Temp/
Logs/

# Local settings, private drafts and source artwork do not belong in public Git.
.claude/
.env
.env.*
*.pem
*.key
*.pfx
*.afdesign
*.psd
/Documentation~/archive/
/Documentation~/product/
/Documentation~/deluxe/
/Documentation~/booth/source/
/Documentation~/booth/BOOTH.md
